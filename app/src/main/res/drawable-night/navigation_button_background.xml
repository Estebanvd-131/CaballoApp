<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Darker background for dark mode -->
    <solid android:color="#B05A3A1A" />

    <!-- Lighter border for visibility on dark surfaces -->
    <stroke
        android:width="2dp"
        android:color="#A0784C" />

    <!-- Touch-friendly size -->
    <size
        android:width="48dp"
        android:height="48dp" />

</shape>
