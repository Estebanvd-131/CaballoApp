<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3C3C3C"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="@color/accent_gold"/>
        </shape>
    </item>

    <!-- Checked -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A3530"/>
            <corners android:radius="16dp"/>
            <stroke android:width="3dp" android:color="@color/accent_gold"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2C2C2C"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#4A4A4A"/>
        </shape>
    </item>
</selector>
