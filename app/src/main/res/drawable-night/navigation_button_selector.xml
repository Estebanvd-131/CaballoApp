<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state - darker feedback for dark mode -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#C05A3A1A" />
            <stroke
                android:width="3dp"
                android:color="#A0784C" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#B05A3A1A" />
            <stroke
                android:width="2dp"
                android:color="#A0784C" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>

</selector>
